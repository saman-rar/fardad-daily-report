# PostgreSQL / Prisma — SOURCE OF TRUTH
# When Prisma Postgres is connected through Vercel Marketplace, Vercel can provide DATABASE_URL automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign secure session cookies (minimum 32 chars in production)
AUTH_SECRET=change-this-to-a-long-random-secret-at-least-32-characters

# Bootstrap administrator. If no ADMIN exists, the app can create this account.
BOOTSTRAP_ADMIN_NAME=مدیر سامانه
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Google Sheets — secondary mirror, one-way: Database -> Google Sheet
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

APP_TIMEZONE=Asia/Tehran
NEXT_PUBLIC_COMPANY_NAME=فناوران سپهر فرداد

# Optional but recommended: protects the Vercel Cron endpoint
CRON_SECRET=change-this-to-another-long-random-secret

# Optional YYYY-MM-DD. If set, employee Sheet history can begin no later than this date.
# By default each employee starts from approval/first-report date.
SHEET_TRACKING_START_DATE=
