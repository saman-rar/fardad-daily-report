generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum ReportStatus {
  SUBMITTED
  LEAVE
}

enum SheetSyncStatus {
  SUCCESS
  FAILED
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  username     String     @unique
  passwordHash String
  role         UserRole   @default(EMPLOYEE)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  approvedAt   DateTime?
  approvedBy   String?
  lastLoginAt  DateTime?
  reports      Report[]

  @@index([status])
  @@index([role])
}

model Report {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportDate   DateTime     @db.Date
  jalaliDate   String
  jalaliYear   Int
  jalaliMonth  Int
  jalaliDay    Int
  reportText   String       @db.Text
  status       ReportStatus @default(SUBMITTED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, reportDate])
  @@index([jalaliYear, jalaliMonth])
  @@index([reportDate])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  title     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SheetSyncLog {
  id            String          @id @default(cuid())
  status        SheetSyncStatus
  triggeredById String?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  usersCount    Int             @default(0)
  reportsCount  Int             @default(0)
  message       String?         @db.Text

  @@index([startedAt])
}
